{
  "name": "aplicativo-vehiculos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.19.1 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:access": "node scripts/run-playwright.mjs tests/e2e/access.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "test:integration": "node --env-file=.env.local scripts/integration.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "bootstrap": "node --env-file=.env.local scripts/bootstrap.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.5.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "pg": "^8.16.0",
    "prettier": "3.6.2",
    "supabase": "2.122.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  }
}
